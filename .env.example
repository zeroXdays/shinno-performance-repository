# Shopify Admin API — used by POST /api/verify-purchase
# Create a custom app in Shopify Admin → Settings → Apps → Develop apps
# with read_orders scope, then install and paste the Admin API access token.
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxx
# Optional: only accept orders whose tags/titles/vendor/sku contain this string (default: shinno)
SHOPIFY_PRODUCT_NEEDLE=shinno

# App Review unlock (required by Apple when features need a purchase)
# Put these credentials in App Review notes.
APP_REVIEW_ORDER=REVIEW
APP_REVIEW_EMAIL=review@shinnoperformance.com
